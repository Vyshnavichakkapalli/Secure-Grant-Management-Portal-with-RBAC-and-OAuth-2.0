# =================================================================
# Secure Grant Management Portal - Environment Configuration
# =================================================================

# Application Server
NODE_ENV=development
PORT=5000

# PostgreSQL Database Configuration
DATABASE_URL=postgresql://postgres:postgres@db:5432/grant_portal_db
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=grant_portal_db

# Redis Cache Configuration
REDIS_URL=redis://cache:6379
REDIS_HOST=cache
REDIS_PORT=6379

# JSON Web Token (JWT) Configuration
# Replace with a cryptographically secure random string in production
JWT_SECRET=super_secret_jwt_signing_key_replace_in_production
JWT_EXPIRES_IN=24h

# OAuth 2.0 Provider Configuration (Google / GitHub)
OAUTH_PROVIDER=google
OAUTH_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
OAUTH_CLIENT_SECRET=your-google-oauth-client-secret
OAUTH_REDIRECT_URI=http://localhost:5000/api/auth/google/callback

# Default Admin User Seed (Created on initial DB setup)
DEFAULT_ADMIN_NAME=Portal Administrator
DEFAULT_ADMIN_EMAIL=admin@grantportal.com
DEFAULT_ADMIN_PASSWORD=AdminPassword123!
